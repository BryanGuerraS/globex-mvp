# Configuración del LLM en Groq (Gratis)
GROQ_API_KEY=tu_gsk_clave_aqui
# Opcional: keys de Groq de respaldo, en orden; se usan si la anterior recibe un 429
GROQ_API_KEY_RESPALDO=
GROQ_API_KEY_RESPALDO_2=
GROQ_MODEL=openai/gpt-oss-120b

META_PHONE_NUMBER_ID=
META_ACCESS_TOKEN=
META_WABA_ID=
META_VERIFY_TOKEN=

# Firma de webhooks: App Secret de Meta (App settings > Basic)
META_APP_SECRET=

# API key compartida backend <-> dashboard (header X-API-Key). Generar con:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
DASHBOARD_API_KEY=

# Opcional: clave para /api/chat (una IA externa conversa con Globix usando SU key de Groq
# en el header X-Groq-Key). Sin valor, /api/chat queda cerrado. Generar igual que la anterior.
CHAT_API_KEY=
# CHAT_API_LIMITE_POR_MINUTO=30

# Opcional: precio de Groq por millón de tokens (gpt-oss-120b)
# GROQ_PRECIO_ENTRADA_USD_M=0.15
# GROQ_PRECIO_SALIDA_USD_M=0.60


# Dashboard (Streamlit)
BACKEND_URL=https://globex-mvp.onrender.com

# Proveedor del LLM: groq (por defecto) o cerebras (mismo modelo gpt-oss-120b)
LLM_PROVEEDOR=groq
CEREBRAS_API_KEY=
CEREBRAS_API_KEY_RESPALDO=
# CEREBRAS_MODEL=gpt-oss-120b

# API de evaluación (/api/eval/*): corre bancos de preguntas con la key de pago de Cerebras
EVAL_API_KEY=
# EVAL_LIMITE_POR_MINUTO=60
# EVAL_MAX_CASOS_DIA=1500
# Juez del equipo en el servidor (/api/eval/juzgar, lo usa evaluacion.py): key de PAGO de Cerebras
JUEZ_CEREBRAS_API_KEY=
# JUEZ_LIMITE_POR_MINUTO=120
# JUEZ_MAX_POR_DIA=1500
