# API key compartida backend <-> dashboard (header X-API-Key). Generar con:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
DASHBOARD_API_KEY=

# Opcional: precio de Groq por millón de tokens (gpt-oss-120b)
# GROQ_PRECIO_ENTRADA_USD_M=0.15
# GROQ_PRECIO_SALIDA_USD_M=0.60

# Opcional: aviso inmediato a los asesores por Telegram al derivar (ver notificaciones.py)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Opcional: enlace a la consola que se incluye en el aviso
DASHBOARD_URL=

# Dashboard (Streamlit)
BACKEND_URL=https://globex-mvp.onrender.com
