# Configuración del LLM en Groq (Gratis)
GROQ_API_KEY=tu_gsk_clave_aqui
GROQ_MODEL=openai/gpt-oss-120b

META_PHONE_NUMBER_ID=
META_ACCESS_TOKEN=
META_WABA_ID=
META_VERIFY_TOKEN=

# Firma de webhooks: App Secret de Meta (App settings > Basic)
